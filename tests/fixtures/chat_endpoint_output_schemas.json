 "blue.catbird.chat.getConversationState": {
  "properties": {
   "pendingLeafRecoveryRequests": {
    "description": "Open unexpired leaf recoveries bound to the current coordinate, visible only to an active concrete device leaf that may fulfill them. Excludes the requesting exact device, but includes other devices of the same DID. Ordered oldest first; successful fulfillment changes the coordinate and stale requests must be renewed. Absent on older servers; empty for logical participants without a current concrete leaf. This is separate from the exact-target-device getLeafRecoveryInbox and grants no additional application history.",
    "items": {
     "ref": "blue.catbird.chat.defs#leafRecoveryView",
     "type": "ref"
    },
    "maxLength": 100,
    "minLength": 0,
    "type": "array"
   },
   "pendingLeaveRequests": {
    "items": {
     "ref": "blue.catbird.chat.defs#leaveRequestView",
     "type": "ref"
    },
    "maxLength": 100,
    "minLength": 0,
    "type": "array"
   },
   "pendingResetRequests": {
    "items": {
     "ref": "blue.catbird.chat.defs#resetRequestView",
     "type": "ref"
    },
    "maxLength": 100,
    "minLength": 0,
    "type": "array"
   },
   "state": {
    "ref": "blue.catbird.chat.defs#conversationState",
    "type": "ref"
   }
  },
  "required": [
   "state",
   "pendingResetRequests",
   "pendingLeaveRequests"
  ],
  "type": "object"
 },
